<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Intestazione -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BlackEye"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Configurazione fotocamere e modalità schermo"
            android:textColor="#9E9EA7"
            android:textSize="14sp" />

        <!-- Card 1: Fotocamera Video (Volume Giù) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="#18181C"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIDEO (TASTO VOLUME GIÙ)"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:text="Scegli quale fotocamera usare per i video"
                android:textColor="#9E9EA7"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgVideoCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbVideoFront"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#E53935"
                    android:text="Anteriore"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbVideoBack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#E53935"
                    android:checked="true"
                    android:text="Posteriore"
                    android:textColor="#FFFFFF" />
            </RadioGroup>
        </LinearLayout>

        <!-- Card 2: Fotocamera Foto (Volume Su) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="#18181C"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOTO (TASTO VOLUME SU)"
                android:textColor="#26A69A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:text="Scegli quale fotocamera usare per le foto"
                android:textColor="#9E9EA7"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgPhotoCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbPhotoFront"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#26A69A"
                    android:text="Anteriore"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbPhotoBack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#26A69A"
                    android:checked="true"
                    android:text="Posteriore"
                    android:textColor="#FFFFFF" />
            </RadioGroup>
        </LinearLayout>

        <!-- Card 3: Modalità Schermo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#18181C"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="MODALITÀ SCHERMO"
                android:textColor="#9E9EA7"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgScreenMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbScreenOn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#E53935"
                    android:checked="true"
                    android:text="Schermo Acceso (Usa il telefono normalmente, tasti attivi ovunque)"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbScreenOff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:buttonTint="#E53935"
                    android:text="Schermo Spento (Schermo nero persistente; triplo tocco per uscire)"
                    android:textColor="#FFFFFF" />
            </RadioGroup>
        </LinearLayout>

        <!-- Pulsante Principale Toggle (Attiva / Disattiva) -->
        <Button
            android:id="@+id/btnMainAction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#E53935"
            android:text="ATTIVA IN BACKGROUND (ESCI DALL'APP)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Servizio in background: INATTIVO"
            android:textColor="#9E9EA7"
            android:textSize="13sp" />

        <!-- Sezione Tasti Rapidi Globali -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#18181C"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvAccessibilityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stato servizio tasti rapidi: NON ATTIVO"
                android:textColor="#FF7043"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEnableAccessibility"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#26A69A"
                android:text="ATTIVA TASTI RAPIDI IN ACCESSIBILITÀ"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
